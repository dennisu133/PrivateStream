# Generate with `bun tools/hash-password.js`. Do not pass the password as a CLI argument.
SITE_PASSWORD_HASH=""

# Generate with `bun tools/generate-session-secret.js`. Rotating this logs out every viewer.
SESSION_SECRET=""

# Show reactions and serve the reactions API. Defaults to true when omitted.
REACTIONS="true"

# The public HTTPS origin used by the production server behind a reverse proxy.
ORIGIN="https://stream.example.com"

# Bun idle timeout in seconds. Must exceed the 15-second SSE heartbeat for chat and reactions.
IDLE_TIMEOUT=60

# The URL of the SRS server. This is used to connect to the SRS server and publish the stream.
SRS_WHEP_URL="http://192.168.1.100:1985/rtc/v1/whep/?app=live&stream=livestream"

VITE_META_TITLE_PUBLIC="PrivateStream"
VITE_META_TITLE_PRIVATE="Welcome back!"
VITE_META_DESCRIPTION="Private livestream viewer for friend groups."

# When Cloudflare is the only public path to the origin, this enables per-viewer throttling.
# ADDRESS_HEADER="cf-connecting-ip"

# Optional
VITE_META_COLOR="#09090b"
# Optional: File needs be externally sourced (e.g., https://example.com/myimage.png)
VITE_OG_IMAGE="https://stream.example.com/og-image.gif"

# Optional: the server's public IP, passed to SRS as the WebRTC candidate (`eip`).
# When set, no external IP lookup services are ever contacted. Use this if your
# public IP is static (e.g. a VPS).
# SERVER_PUBLIC_IP="203.0.113.7"

# Optional: comma-separated plain-text IP echo services, tried in order when
# SERVER_PUBLIC_IP is unset. Each must return the caller's IP as the response body.
# Defaults to api.ipify.org, ipv4.icanhazip.com and checkip.amazonaws.com.
# IP_LOOKUP_URLS="https://api.ipify.org, https://ipv4.icanhazip.com"

# Skips the password gate entirely; every visitor is treated as logged in.
# Only for local development and testing — never set this in production.
# DANGEROUSLY_DISABLE_AUTH="true"
