{
	"name": "private-stream",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"build:boring": "bun --bun vite build --mode boring",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^24.13.3",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"subset-font": "^2.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@lucide/svelte": "^0.553.0",
		"bcrypt": "^6.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
